{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/internal/frozenInternals.ts",
    "benchmarks/**/*.{js,mjs,ts}",
    "testSupport/**/*.{js,ts}"
  ],
  "project": [
    "src/**/*.{ts,js}"
  ],
  "ignore": [
    "src/**/*.test.js",
    "src/binaryFormat.ts",
    "src/msv5/binaryMsv5Encode.ts"
  ],
  "vitest": false,
  "bun": false,
  "tags": [
    "-testonly"
  ],
  "ignoreBinaries": [
    "make"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "vitest",
    "@vitest/coverage-v8",
    "crc-32"
  ],
  "exclude": [
    "duplicates"
  ]
}
